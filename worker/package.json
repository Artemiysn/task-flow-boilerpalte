{
  "name": "api-service",
  "version": "1.0.0",
  "description": "Express backend with TypeScript",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --ext ts --exec tsx watch src/app.ts",
    "test": "jest",
    "migrate:create": "npx dotenv-cli -e ./../.env node-pg-migrate create",
    "migrate:up": "npx dotenv-cli -e ./../.env node-pg-migrate up --env=dev",
    "migrate:down": "npx dotenv-cli -e ./../.env node-pg-migrate down --env=dev",
    "migrate:up:prod": "npx dotenv-cli -e ./../.env node-pg-migrate up --env=prod"
  },
  "dependencies": {
    "amqplib": "0.10",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "redis": "^5.9.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/redis": "^4.0.11",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
